# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Web Push VAPID Keys
# Generate via: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BExampleKeyPublic_XXXXXXXXXXXXXX
VAPID_PRIVATE_KEY=YourPrivateKey_XXXXXXXXXXXXXX
VAPID_SUBJECT=mailto:admin@fitlifetracker.com

# Vercel Cron Secret (Optional for securing cron endpoints)
CRON_SECRET=your_super_secret_cron_token
